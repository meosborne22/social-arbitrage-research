      ],
      "properties": {
        "what_consumers_are_doing": {
          "type": "string"
        },
        "first_detected": {
          "type": "string"
        }
      }
    },
    "company": {
      "type": "string"
    },
    "ticker": {
      "type": "string"
    },
    "level": {
