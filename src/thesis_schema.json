      "minimum": 0,
      "maximum": 100
    },
    "evidence": {
      "type": "array"
    },
    "contradictions": {
      "type": "array"
    },
    "catalyst": {
      "type": "string"
    },
    "invalidation": {
      "type": "string"
    },
    "bear_case": {
